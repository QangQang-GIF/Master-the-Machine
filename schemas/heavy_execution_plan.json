{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HeavyExecutionPlan",
  "type": "object",
  "required": [
    "planVersion",
    "parentBacklogItemKey",
    "parentAgentId",
    "baseRevision",
    "deadlineEpoch",
    "subtasks"
  ],
  "properties": {
    "planVersion": {
      "const": 1
    },
    "parentBacklogItemKey": {
      "type": "string",
      "pattern": "^(TASK|CR|BUG|PI)-[A-Za-z0-9_-]+$"
    },
    "parentAgentId": {
      "type": "string"
    },
    "baseRevision": {
      "type": "string"
    },
    "deadlineEpoch": {
      "type": "number"
    },
    "subtasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "subtaskId",
          "description",
          "ownedPaths",
          "estimatedSeconds"
        ],
        "properties": {
          "subtaskId": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ownedPaths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "expectedOutputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "estimatedSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "modelProfile": {
            "type": "string"
          },
          "reasoningEffort": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      }
    }
  }
}
