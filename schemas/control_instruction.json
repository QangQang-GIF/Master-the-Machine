{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ControlInstruction",
  "type": "object",
  "required": [
    "type",
    "instructionId",
    "backlogItemKey",
    "state",
    "requiredActions"
  ],
  "properties": {
    "type": {
      "type": "string"
    },
    "instructionId": {
      "type": "string"
    },
    "backlogItemKey": {
      "type": "string"
    },
    "serverDeadlineEpoch": {
      "type": [
        "number",
        "null"
      ]
    },
    "state": {
      "enum": [
        "DEADLINE_WARNING",
        "CODE_FREEZE",
        "EVIDENCE_PRIORITY",
        "HANDOFF",
        "FINALIZATION"
      ]
    },
    "priority": {
      "type": "string"
    },
    "requiredActions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
