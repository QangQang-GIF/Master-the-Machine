{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkerResult",
  "type": "object",
  "required": [
    "task_id",
    "status",
    "skill_ids",
    "changed_files",
    "test_results",
    "evidence_paths",
    "elapsed_seconds"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["READY_FOR_REVIEW", "PARTIAL", "DONE", "BLOCKED", "TIMED_OUT", "FAILED", "ESCALATE"]
    },
    "skill_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "changed_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "test_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "passed"],
        "properties": {
          "command": { "type": "string" },
          "passed": { "type": "boolean" },
          "output": { "type": "string" },
          "exit_code": { "type": ["integer", "null"] }
        }
      }
    },
    "evidence_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "git_revision": {
      "type": ["string", "null"]
    },
    "unresolved_risks": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": ["integer", "null"] },
        "cached_input_tokens": { "type": ["integer", "null"] },
        "output_tokens": { "type": ["integer", "null"] },
        "credits": { "type": ["number", "null"] }
      }
    },
    "base_revision": {
      "type": ["string", "null"]
    },
    "result_revision": {
      "type": ["string", "null"]
    },
    "mvs_results": {
      "type": "array",
      "items": { "type": "object" },
      "default": []
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "model": {
      "type": ["string", "null"]
    },
    "effort": {
      "type": ["string", "null"]
    },
    "verification_status": {
      "type": "string",
      "enum": ["VERIFIED", "EVIDENCE_ONLY", "RECORDED", "UNVERIFIED"],
      "description": "RECORDED: stored, MVS not passed. VERIFIED: MVS passed with executed commands. EVIDENCE_ONLY: MVS PASS in the answer, no command executed. UNVERIFIED: failed/blocked result or explicit flush."
    },
    "cutoff_triggered": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    },
    "worker_id": { "type": "string" },
    "attempt_id": {
      "type": ["string", "null"],
      "description": "Attempt identity from the TaskEnvelope; a result of another attempt is kept for audit only."
    },
    "mvs_passed": {
      "type": "boolean",
      "description": "Computed by the coordinator: every required scenario PASS in the answer and every executed command passed."
    },
    "diagnostic_test_results": {
      "type": "array",
      "description": "A failing row blocks VERIFIED unless it has unrelated=true and baseline_log.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "passed": { "type": "boolean" },
          "exit_code": { "type": ["integer", "null"] },
          "unrelated": { "type": "boolean" },
          "baseline_log": { "type": "string" }
        }
      }
    }
  }
}
